# Copy to .env.local for development. Production values are set in Railway (see DEPLOY.md).
DATABASE_URL=postgres://postgres:postgres@localhost:54329/questmeals
# Used by db tests, e2e and the week simulation (reset freely)
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:54329/questmeals_test

# Better Auth
BETTER_AUTH_SECRET=dev-only-secret-change-me-32-characters-min
BETTER_AUTH_URL=http://localhost:3000

# Files: local (folder .data/storage) or s3 (Railway Bucket)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/storage
FILE_URL_SECRET=dev-only-file-url-secret
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Scheduled jobs (Railway cron sends this in x-cron-secret)
CRON_SECRET=dev-cron-secret

# Telegram (optional; without a token notifications are in-app only)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Public base URL used in notification links
APP_URL=http://localhost:3000
